# Copie este arquivo para .env e preencha localmente.
# NUNCA commitar .env com valores reais — .gitignore já exclui .env.
#
# Nada aqui é lido pelo site hoje: o protótipo atual é 100% estático e não
# faz nenhuma chamada a API externa. Estas variáveis documentam onde as
# integrações reais vão entrar mais adiante — sempre por trás de um backend
# ou função serverless, nunca direto do código que roda no navegador.

# WhatsApp Business API (envio automatizado — hoje o site só usa links
# wa.me de clique-para-conversar, que não precisam de token nenhum).
WHATSAPP_BUSINESS_API_TOKEN=

# Integração futura com o ERP da Passini (estoque, preços, catálogo real).
PASSINI_ERP_API_URL=
PASSINI_ERP_API_KEY=

# Provedor de IA real, caso a Passini IA baseada em regras seja substituída
# por um modelo de linguagem de verdade (js/services/ia-service.js).
IA_PROVIDER_API_KEY=

# Autenticação do painel administrativo (admin/), hoje inexistente.
ADMIN_AUTH_SECRET=

# URL base usada para gerar sitemap.xml e URLs canônicas/Open Graph.
SITE_URL=https://www.passinidistribuidora.com.br
